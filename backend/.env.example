# Variáveis do core-api. Documentação completa: docs/ENVIRONMENT_VARIABLES.md
# Os nomes têm de bater com os campos de app/core/config.py (sem diferenciar
# maiúsculas). Nome errado é IGNORADO sem aviso (extra="ignore") — ver ISS-001.

ENVIRONMENT=dev

# Runtime: role sem DDL (DEC-012). Migrations e DDL do provisionamento: dono do schema.
DATABASE_URL=postgresql+asyncpg://navalha_app:navalha_app@localhost:5433/navalha
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://navalha:navalha@localhost:5433/navalha
REDIS_URL=redis://localhost:6380/0

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-apenas-troque-em-producao-com-48-bytes-aleatorios
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
INVITE_EXPIRY_DAYS=7

# Cada barbearia atende em <slug>.<BASE_DOMAIN>
BASE_DOMAIN=navalha.local

# Conta de suporte da plataforma: python -m app.management.seed platform-admin
# Sem senha definida, o seed gera uma e a mostra uma única vez.
SEED_ADMIN_EMAIL=suporte@navalha.app
SEED_ADMIN_NAME=Suporte Navalha
# SEED_ADMIN_PASSWORD=
