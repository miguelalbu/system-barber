AMBIENTE=dev

DATABASE_URL=postgresql+asyncpg://navalha_app:navalha_app@localhost:5433/navalha
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://navalha:navalha@localhost:5433/navalha
REDIS_URL=redis://localhost:6379/0

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-apenas-troque-em-producao-com-48-bytes-aleatorios
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30
CONVITE_VALIDADE_DIAS=7

# Cada barbearia atende em <slug>.<DOMINIO_BASE>
DOMINIO_BASE=navalha.local

# Desligue para provisionar cada barbearia manualmente
PERMITIR_AUTOCADASTRO=true

# Platform support account, created by: python -m app.seed platform-admin
# With no password set, the seed generates one and prints it once.
SEED_ADMIN_EMAIL=suporte@navalha.app
SEED_ADMIN_NAME=Suporte Navalha
# SEED_ADMIN_PASSWORD=
