            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "status",
          "job_id"
        ],
        "title": "ProvisionAccepted",
        "type": "object"
      },
      "ProvisionIn": {
        "description": "Unknown fields are dropped — on purpose for `password`: the owner's password\nnever travels in this contract (doc §6) and never reaches the audit log.",
        "properties": {
          "custom_domain": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Domain"
          },
          "external_tenant_id": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Core's id for this customer",
            "title": "External Tenant Id"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/OwnerIn"
          },
          "plan": {
            "default": "basic",
            "maxLength": 40,
            "title": "Plan",
            "type": "string"
          },
          "slug": {
            "description": "Subdomain and schema of the shop: <slug>.<base_domain>",
            "title": "Slug",
            "type": "string"
          },
          "unit_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Name"
          }
        },
        "required": [
          "slug",
          "name",
          "owner"
        ],
        "title": "ProvisionIn",
        "type": "object"
      },
      "TenantStatus": {
        "description": "Operational lifecycle of a shop (DEC-013). Billing lives in the Core; only\n`active` is served.",
        "enum": [
          "provisioning",
          "active",
          "failed",
          "suspended",
          "archived"
        ],
        "title": "TenantStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
