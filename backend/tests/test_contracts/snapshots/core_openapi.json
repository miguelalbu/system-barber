        "title": "JobOut",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "JobStep": {
        "description": "Provisioning steps, in order. Each one is idempotent, so a retry resumes.",
        "enum": [
          "schema",
          "migrations",
          "grants",
          "bootstrap",
          "activate",
          "done"
        ],
        "title": "JobStep",
        "type": "string"
      },
      "OwnerIn": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "title": "OwnerIn",
        "type": "object"
      },
      "ProvisionAccepted": {
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TenantStatus"
