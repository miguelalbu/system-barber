                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a suspended shop's data (scope tenant:destroy)",
        "tags": [
          "core"
        ]
      },
      "get": {
        "operationId": "get_tenant_core_tenants__tenant_id__get",
