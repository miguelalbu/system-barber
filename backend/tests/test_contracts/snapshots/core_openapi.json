  "info": {
    "description": "Called by the platform Core. Authenticate with the `X-Core-Key` header.",
    "title": "Navalha · Control plane",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/core/openapi.json": {
      "get": {
        "operationId": "core_openapi_core_openapi_json_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-core-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Core-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "OpenAPI of the control plane",
        "tags": [
          "core"
        ]
      }
    },
    "/core/tenants": {
      "get": {
        "operationId": "list_tenants_core_tenants_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-core-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Core-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CoreTenantOut"
                  },
                  "title": "Response List Tenants Core Tenants Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Every shop",
        "tags": [
          "core"
        ]
      },
      "post": {
        "description": "Validates, records and answers **202** with the job; the work runs after\nthe response. The same slug (or `Idempotency-Key`) again answers **200**\nwith the existing job — never a second schema.",
        "operationId": "provision_core_tenants_post",
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "in": "header",
            "name": "x-core-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Core-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Provision a shop (async: 202 + job)",
        "tags": [
          "core"
        ]
      }
    },
